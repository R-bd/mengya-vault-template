# macOS
.DS_Store

# Obsidian 运行状态与插件数据
.obsidian/workspace*.json
.obsidian/cache/
.obsidian/plugins/*/data.json
.trash/

# Python
__pycache__/
*.pyc

# 凭据与会话
.env*
*.pem
*.key
*cookie*
*storage-state*

# 私人导出配置（含真实姓名）
替换表*.json
replacements*.json
私有词表*.txt
private-terms*.txt

# 媒体、文档原件和 Anki 包不进模板
*.m4a
*.mp3
*.mp4
*.wav
*.apkg
*.colpkg
*.pdf
*.docx
*.pptx
*.xlsx
